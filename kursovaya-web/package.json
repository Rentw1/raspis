{
  "name": "kursovaya-web",
  "private": true,
  "version": "1.0.0",
  "description": "Курсовая ЛТЭТ — PWA для написания курсовой по регламенту ГАПОУ «Лаишевский технико-экономический техникум»",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "metrics": "python3 scripts/font-metrics.py"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
